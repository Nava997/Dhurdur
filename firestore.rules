rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = a VERIFIED email on the allow-list, or a user doc with role 'admin'.
    // email_verified is required: Firebase email/password sign-up does not verify
    // ownership, so without it anyone could register an allow-listed address
    // (if it isn't registered yet) and get full admin access.
    // Keep this list in sync with NEXT_PUBLIC_ADMIN_EMAIL / storage.rules.
    function isAdmin() {
      return request.auth != null && (
        (request.auth.token.email_verified == true &&
          request.auth.token.email in ['durdurbarbershop@gmail.com']) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isOwnerOrAdmin(userId) {
      return isOwner(userId) || isAdmin();
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // A customer's reference photo must be an image in their own folder of the
    // salon's Cloudinary account (see /api/cloudinary/sign), never an arbitrary link.
    function validReferenceImage(data) {
      return !('referenceImage' in data) || (
        data.referenceImage is string &&
        data.referenceImage.matches(
          '^https://res[.]cloudinary[.]com/a2x0mlwu/image/upload/(v[0-9]+/)?dhurdur/reference/' +
          request.auth.uid + '/[A-Za-z0-9_-]+[.](jpg|jpeg|png|webp)$')
      );
    }

    // Shape of a customer's booking: bounded strings, no unexpected types.
    function validBooking(d) {
      return d.name is string && d.name.size() <= 100
        && d.phone is string && d.phone.size() <= 40
        && d.services is list && d.services.size() > 0 && d.services.size() <= 20
        && d.totalDurationMins is number && d.totalDurationMins > 0 && d.totalDurationMins <= 600
        && d.stylist is string && d.stylist.size() <= 100
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.time is string && d.time.matches('^[0-9]{2}:[0-9]{2}$')
        && d.sendsms is bool
        && (!('specialRequests' in d) || (d.specialRequests is string && d.specialRequests.size() <= 1000))
        && (!('isEmergency' in d) || d.isEmergency is bool);
    }

    match /users/{userId} {
      allow read: if isOwnerOrAdmin(userId);
      allow delete: if isAdmin();
      allow write: if isAdmin();

      // Customers create their own profile as a plain user with 0 loyalty points.
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['id', 'name', 'email', 'phone', 'haircutCount', 'role', 'photoURL', 'hasUpdatedPassword'])
        && request.resource.data.id == userId
        && request.resource.data.role == 'user'
        && request.resource.data.haircutCount == 0;

      // Customers may edit their own contact details only. Loyalty points are
      // awarded server-side (/api/appointments/notify), never by the browser.
      allow update: if isOwner(userId)
        && changed().hasOnly(['name', 'email', 'phone', 'photoURL', 'hasUpdatedPassword']);
    }

    match /clientNotes/{userId} {
      allow read, write: if isAdmin();
    }

    match /appointments/{apptId} {
      // Bookings contain names/phones — only the owner and admins may read them.
      // Public availability is served PII-free by /api/available-slots.
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);

      allow create: if isAdmin() || (
        isOwner(request.resource.data.userId)
        && request.resource.data.status == 'pending'
        && request.resource.data.usedReward == false
        && request.resource.data.keys().hasOnly([
             'userId', 'name', 'phone', 'services', 'totalDurationMins', 'stylist',
             'date', 'time', 'status', 'sendsms', 'usedReward', 'specialRequests',
             'referenceImage', 'isEmergency'])
        && validBooking(request.resource.data)
        && validReferenceImage(request.resource.data)
      );

      allow update: if isAdmin() || (
        isOwner(resource.data.userId) && (
          (changed().hasOnly(['referenceImage']) && validReferenceImage(request.resource.data)) ||
          // Customers may cancel their own open booking (status only).
          (resource.data.status in ['pending', 'confirmed'] &&
            request.resource.data.status == 'cancelled' &&
            changed().hasOnly(['status'])) ||
          (
            resource.data.status == 'proposed' &&
            (
              // Accepting moves the booking to exactly the proposed slot.
              (request.resource.data.status == 'confirmed' &&
                changed().hasOnly(['status', 'date', 'time', 'proposedDate', 'proposedTime']) &&
                request.resource.data.date == resource.data.proposedDate &&
                request.resource.data.time == resource.data.proposedTime &&
                request.resource.data.proposedDate == null &&
                request.resource.data.proposedTime == null) ||
              (request.resource.data.status == 'cancelled' &&
                changed().hasOnly(['status']))
            )
          )
        )
      );
      allow delete: if isAdmin();
    }

    match /services/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /products/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /stylists/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /alerts/{alertId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      // Customers create an alert for themselves when accepting a proposal.
      allow create: if isAdmin() || (
        isOwner(request.resource.data.userId)
        && request.resource.data.keys().hasOnly(['userId', 'message', 'isRead', 'link', 'createdAt'])
        && request.resource.data.message is string && request.resource.data.message.size() <= 500
      );
      allow update: if isAdmin() || (isOwner(resource.data.userId) && changed().hasOnly(['isRead']));
      allow delete: if isAdmin() || isOwner(resource.data.userId);
    }

    match /waitlist/{waitlistId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      // Entries are added by the salon; there is no customer sign-up flow.
      allow create, update, delete: if isAdmin();
    }

    // consentLogs and anything else: server (Admin SDK) only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
